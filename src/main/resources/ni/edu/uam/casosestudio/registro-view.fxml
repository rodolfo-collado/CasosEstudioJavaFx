<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fx:id="rootScrollPane" fitToWidth="true" hbarPolicy="NEVER" onKeyPressed="#onKeyPressed" prefHeight="640.0" prefWidth="680.0" style="-fx-background-color: #f4f7fb; -fx-background: #f4f7fb;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.casosestudio.controller.RegistroController">
    <content>
        <VBox alignment="CENTER" spacing="22.0" style="-fx-background-color: #f4f7fb;">
            <fx:define>
                <ToggleGroup fx:id="modalidadGroup" />
            </fx:define>
            <padding>
                <Insets bottom="32.0" left="44.0" right="44.0" top="32.0" />
            </padding>
            <children>
                <HBox alignment="CENTER" spacing="16.0">
                    <children>
                        <Label text="Registro de estudiantes" textAlignment="CENTER" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #17324d;" />
                        <ImageView fx:id="imgRegistro" fitHeight="72.0" fitWidth="72.0" pickOnBounds="true" preserveRatio="true" />
                    </children>
                </HBox>

                <GridPane hgap="14.0" maxWidth="540.0" vgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="160.0" prefWidth="180.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="280.0" prefWidth="340.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="38.0" />
                        <RowConstraints minHeight="38.0" />
                        <RowConstraints minHeight="38.0" />
                        <RowConstraints minHeight="110.0" />
                        <RowConstraints minHeight="38.0" />
                        <RowConstraints minHeight="86.0" />
                        <RowConstraints minHeight="38.0" />
                    </rowConstraints>
                    <children>
                        <Label text="Nombre completo:" style="-fx-font-size: 14px; -fx-text-fill: #263849;" />
                        <TextField fx:id="txtNombreCompleto" prefHeight="36.0" promptText="Ingrese el nombre completo" GridPane.columnIndex="1" />

                        <Label text="Fecha de nacimiento:" style="-fx-font-size: 14px; -fx-text-fill: #263849;" GridPane.rowIndex="1" />
                        <DatePicker fx:id="dpFechaNacimiento" prefHeight="36.0" prefWidth="340.0" promptText="Seleccione la fecha" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Departamento:" style="-fx-font-size: 14px; -fx-text-fill: #263849;" GridPane.rowIndex="2" />
                        <ComboBox fx:id="cbDepartamento" prefHeight="36.0" prefWidth="340.0" promptText="Seleccione un departamento" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Curso:" style="-fx-font-size: 14px; -fx-text-fill: #263849;" GridPane.rowIndex="3" />
                        <ListView fx:id="lvCursos" prefHeight="105.0" prefWidth="340.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Modalidad:" style="-fx-font-size: 14px; -fx-text-fill: #263849;" GridPane.rowIndex="4" />
                        <HBox alignment="CENTER_LEFT" spacing="18.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <children>
                                <RadioButton fx:id="rbPresencial" selected="true" text="Presencial" toggleGroup="$modalidadGroup" />
                                <RadioButton fx:id="rbVirtual" text="Virtual" toggleGroup="$modalidadGroup" />
                            </children>
                        </HBox>

                        <Label text="Horarios:" style="-fx-font-size: 14px; -fx-text-fill: #263849;" GridPane.rowIndex="5" />
                        <VBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                            <children>
                                <CheckBox fx:id="chkHorarioManana" text="Mañana" />
                                <CheckBox fx:id="chkHorarioTarde" text="Tarde" />
                                <CheckBox fx:id="chkHorarioSabado" text="Sábado" />
                            </children>
                        </VBox>

                        <Label text="Normas:" style="-fx-font-size: 14px; -fx-text-fill: #263849;" GridPane.rowIndex="6" />
                        <CheckBox fx:id="chkAceptaNormas" text="Acepto las normas de matrícula" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                    </children>
                </GridPane>

                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button fx:id="btnGuardar" defaultButton="true" minWidth="110.0" onAction="#onGuardarClick" text="Guardar" style="-fx-background-color: #1f6feb; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Button fx:id="btnActualizar" minWidth="110.0" onAction="#onActualizarClick" text="Actualizar" style="-fx-background-color: #2ea043; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Button fx:id="btnLimpiar" cancelButton="true" minWidth="110.0" onAction="#onLimpiarClick" text="Limpiar" style="-fx-background-color: #6e7681; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Button fx:id="btnEliminar" minWidth="110.0" onAction="#onEliminarClick" text="Eliminar" style="-fx-background-color: #da3633; -fx-text-fill: white; -fx-font-weight: bold;" />
                    </children>
                </HBox>

                <Separator maxWidth="580.0" />

                <TableView fx:id="tblEstudiantes" onMouseClicked="#onTableMouseClicked" maxWidth="600.0" prefHeight="200.0" style="-fx-background-color: white; -fx-border-color: #d0d7de; -fx-border-radius: 6px;">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre completo" />
                        <TableColumn fx:id="colFechaNacimiento" prefWidth="110.0" text="Fecha de nacimiento" />
                        <TableColumn fx:id="colDepartamento" prefWidth="110.0" text="Departamento" />
                        <TableColumn fx:id="colCurso" prefWidth="120.0" text="Curso" />
                        <TableColumn fx:id="colModalidad" prefWidth="90.0" text="Modalidad" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </content>
</ScrollPane>
